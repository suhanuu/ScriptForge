<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scriptforge.mapper.NovelMapper">

    <select id="selectByUuid" resultType="com.scriptforge.model.entity.Novel">
        SELECT * FROM novels WHERE uuid = #{uuid}
    </select>

</mapper>
